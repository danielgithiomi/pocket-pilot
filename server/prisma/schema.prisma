// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                String  @id() @default(uuid())
    name              String
    email             String
    password          String
    phoneNumber       String?
    profilePictureKey String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Account locking
    lastLoginAt         DateTime?
    failedLoginAttempts Int       @default(0)
    isAccountLocked     Boolean   @default(false)

    // Onboarding
    isOnboarded Boolean @default(false)

    // Link to accounts - one-to-many
    accounts Account[]

    // Link to categories - one-to-many
    categories Categories[]

    // Link to goals - one-to-many
    goals Goals[]

    // Link to bills - one-to-many
    bills Bills[]

    // Link to features - one-to-many
    features Feature[]

    // Link to splitr events - one-to-many
    splitrEvents SplitrEvent[]

    // Link to feature votes - one-to-many
    featureVotes FeatureVotes[]

    // Link to preferences - one-to-one
    userPreferences UserPreferences?

    // Link to feature comments - one-to-many
    comments FeatureComments[] @relation("UserFeatureComments")

    // Link to notifications - one-to-many
    notifications Notification[]

    @@unique([email])
    @@map("Users")
}

enum AccountType {
    LOAN
    BANK
    CRYPTO
    CREDIT
    WALLET
    SAVINGS
    CURRENT
    DEPOSIT
    OVERDRAFT
    BROKERAGE
    RETIREMENT
}

model Account {
    id        String      @id @default(uuid())
    type      AccountType
    name      String
    currency  String
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    balance   Float       @default(0)

    isBalanceVisible Boolean @default(true)

    // Link to user - one-to-many
    holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
    holderId String

    // Transactions where this account is the SOURCE
    outgoingTransactions Transaction[] @relation("SourceAccountTransactions")

    // Transactions where this account is the TARGET
    incomingTransactions Transaction[] @relation("TargetAccountTransactions")

    @@unique([name, holderId])
    @@map("Accounts")
}

enum ApplicationTheme {
    SYSTEM
    LIGHT
    DARK
}

model UserPreferences {
    id String @id @default(uuid())

    monthlySpendingLimit Float
    defaultCurrency      String
    preferredLanguage    String
    preferredTheme       ApplicationTheme @default(SYSTEM)

    createdAt DateTime @default(now())

    // Link to user - one-to-one
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@unique([userId])
    @@map("User Preferences")
}

enum TransactionType {
    INCOME
    EXPENSE
    TRANSFER
}

model Transaction {
    id          String          @id() @default(uuid())
    amount      Float
    type        TransactionType
    description String?
    category    String
    date        DateTime        @default(now())

    // SOURCE ACCOUNT (money comes from)
    sourceAccount   Account @relation("SourceAccountTransactions", fields: [sourceAccountId], references: [id], onDelete: Cascade)
    sourceAccountId String

    // TARGET ACCOUNT (money goes to) — optional
    targetAccount   Account? @relation("TargetAccountTransactions", fields: [targetAccountId], references: [id], onDelete: Cascade)
    targetAccountId String?

    @@index([sourceAccountId])
    @@index([targetAccountId])
    @@map("Transactions")
}

enum CategoryType {
    INCOME
    EXPENSE
}

model Categories {
    id          String   @id @default(uuid())
    incomes     String[]
    expenses    String[]
    createdAt   DateTime @default(now())
    lastUpdated DateTime @updatedAt()

    // Link to user - one-to-many
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId])
    @@map("User Transaction Categories")
}

enum GoalStatus {
    ACTIVE
    PAUSED
    FAILED
    PENDING
    COMPLETED
}

enum GoalCategory {
    LOAN
    TRAVEL
    SAVINGS
    PURCHASE
    VACATION
    EDUCATION
    RETIREMENT
    INVESTMENTS
    DEBT_PAYMENT
    EMERGENCY_FUND
    OTHER
}

model Goals {
    id String @id @default(uuid())

    name        String
    currency    String
    description String

    endDate   DateTime
    startDate DateTime

    status   GoalStatus   @default(ACTIVE)
    category GoalCategory

    monthlyContribution Float
    targetAmount        Float
    currentAmount       Float @default(0)

    updatedAt DateTime @updatedAt()
    createdAt DateTime @default(now())

    // Link to user - one-to-many
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("Financial Goals")
}

enum BillType {
    YEARLY
    MONTHLY
    ONE_TIME
}

model Bills {
    id String @id @default(uuid())

    amount   Float
    name     String
    type     BillType
    currency String

    dueDate DateTime

    createdAt DateTime @default(now())

    // Link to user - one-to-many
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("User Bills")
}

enum SplitStrategy {
    SOLE
    EQUAL
    QUANTITY
}

enum PaymentStrategy {
    ONE
    EQUAL
    CUSTOM
}

model SplitrSquad {
    id        String @id @default(uuid())
    creatorId String

    squadName     String
    squadImageKey String?
    squadMembers  String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@map("Splitr Squads")
}

model QuantitySplit {
    id String @id @default(uuid())

    consumerQuantity Float
    consumerName     String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // Link to splittable - one-to-many
    splittableId String
    splittable   Splittable @relation(fields: [splittableId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Quantity Splits")
}

model BillPayer {
    id String @id @default(uuid())

    payerName   String
    payerAmount Float

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // Link to splitr event - one-to-many
    splitrEventId String
    splitrEvent   SplitrEvent @relation(fields: [splitrEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Bill Payers")
}

model Splittable {
    id String @id @default(uuid())

    name      String
    quantity  Int
    unitPrice Float

    total         Float
    splitStrategy SplitStrategy

    updatedAt DateTime @updatedAt()
    createdAt DateTime @default(now())

    // Link to quantity splits - one-to-many
    quantitySplits QuantitySplit[]

    splitrEventId String
    splitrEvent   SplitrEvent @relation(fields: [splitrEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Splittables")
}

model SplitrEvent {
    id String @id @default(uuid())

    eventName String
    eventDate DateTime

    squadName    String
    eventMembers String[]

    verificationTotal   Float
    billingCurrency     String
    billPaymentStrategy PaymentStrategy
    billPayers          BillPayer[]

    eventSplittables Splittable[]

    isSettled Boolean @default(false)

    settledAt DateTime?
    updatedAt DateTime  @updatedAt()
    createdAt DateTime  @default(now())

    // Link to user - one-to-many
    userId  String
    creator User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("Splitr Events")
}

enum FeatureStatus {
    NEW
    SHIPPED
    PLANNED
    REJECTED
    IN_PROGRESS
    UNDER_REVIEW
}

enum FeatureCategory {
    OTHER
    UI_UX
    SPLITR
    PROFILE
    ACCOUNTS
    ANALYSIS
    SECURITY
    BUDGETING
    BUG_REPORT
    PERFORMANCE
    NEW_FEATURE
    TRANSACTIONS
    BILLS_AND_GOALS
}

model Feature {
    id String @id @default(uuid())

    featureTitle   String
    featureContent String

    upvoteCount Int @default(0)

    featureCategory FeatureCategory
    featureStatus   FeatureStatus   @default(NEW)

    updatedAt DateTime @updatedAt()
    createdAt DateTime @default(now())

    // Link to feature votes - one-to-many
    featureVotes FeatureVotes[] @relation("FeatureVotes")

    // Link to feature comments - one-to-many
    featureComments FeatureComments[] @relation("FeatureComments")

    // Link to user - one-to-many
    authorId String
    user     User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    @@unique([id, authorId])
    @@map("Feature Requests")
}

model FeatureComments {
    id String @id @default(uuid())

    comment String

    createdAt DateTime @default(now())

    // Link to the user - one-to-one
    userId String
    author User   @relation("UserFeatureComments", fields: [userId], references: [id], onDelete: Cascade)

    // Link to feature - one-to-many
    featureId String
    feature   Feature @relation("FeatureComments", fields: [featureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Feature Comments")
}

model FeatureVotes {
    id String @id @default(uuid())

    updatedAt DateTime @updatedAt()
    createdAt DateTime @default(now())

    // Link to user - many-to-one
    userId String
    voter  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Link to feature - many-to-one
    featureId String
    feature   Feature @relation("FeatureVotes", fields: [featureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([featureId, userId])
    @@map("Feature Votes")
}

model ExchangeRateSnapshot {
    id String @id @default(uuid())

    baseCurrency String

    exchangeRates ExchangeRate[]

    nextUpdateTime  DateTime @db.Timestamptz(3)
    lastUpdatedTime DateTime @db.Timestamptz(3)

    fetchedAt DateTime @default(now()) @db.Timestamptz(3)

    @@unique([baseCurrency, lastUpdatedTime])
    @@map("Exchange Rate Snapshots")
}

model ExchangeRate {
    id String @id @default(uuid())

    currency String // USD, EUR, GBP
    rate     Decimal @db.Decimal(18, 8)

    snapshotId String
    snapshot   ExchangeRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

    @@unique([snapshotId, currency])
    @@map("Exchange Rates")
}

enum NotificationStatus {
    UNREAD
    READ
    ARCHIVED
}

enum NotificationPriority {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

enum NotificationCategory {
    BILL
    BUDGET
    TRANSACTION
    ACCOUNT
    GOAL
    SECURITY
    SYSTEM
}

enum NotificationType {
    BILL_DUE_SOON
    BILL_OVERDUE
    BILL_PAID
    BUDGET_WARNING
    BUDGET_EXCEEDED
    LARGE_TRANSACTION
    UNUSUAL_SPENDING
    ACCOUNT_BALANCE_LOW
    BANK_SYNC_FAILED
    GOAL_MILESTONE
    SECURITY_ALERT
    SYSTEM_UPDATE
}

model Notification {
    id String @id @default(uuid())

    type     NotificationType
    category NotificationCategory
    priority NotificationPriority @default(LOW)
    status   NotificationStatus   @default(UNREAD)

    title        String
    message      String
    shortMessage String?
    icon         String
    accentColor  String?

    resource Json?
    metadata Json?
    actions  Json?

    requiresAction Boolean @default(false)

    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    readAt     DateTime?
    archivedAt DateTime?
    expiresAt  DateTime?

    // Used by notification producers to avoid creating duplicate alert rows.
    dedupeKey String?

    // Link to user - one-to-many
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, dedupeKey])
    @@index([userId, status])
    @@index([userId, category])
    @@index([userId, priority])
    @@map("Notifications")
}
