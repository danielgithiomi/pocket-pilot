// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum AccountType {
    LOAN
    BANK
    CRYPTO
    CREDIT
    WALLET
    SAVINGS
    CURRENT
    DEPOSIT
    OVERDRAFT
    BROKERAGE
    RETIREMENT
}

model Account {
    id        String      @id @default(uuid())
    type      AccountType
    name      String
    currency  String
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    balance   Float       @default(0)

    // Link to user - one-to-many
    holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
    holderId String

    // Transactions where this account is the SOURCE
    outgoingTransactions Transaction[] @relation("SourceAccountTransactions")

    // Transactions where this account is the TARGET
    incomingTransactions Transaction[] @relation("TargetAccountTransactions")

    @@unique([name, holderId])
    @@map("Accounts")
}

model User {
    id                String  @id() @default(uuid())
    name              String
    email             String
    password          String
    phoneNumber       String?
    profilePictureKey String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Account locking
    lastLoginAt         DateTime?
    failedLoginAttempts Int       @default(0)
    isAccountLocked     Boolean   @default(false)

    // Onboarding
    isOnboarded Boolean @default(false)

    // Link to accounts - one-to-many
    accounts Account[]

    // Link to categories - one-to-many
    categories Categories[]

    // Link to preferences - one-to-one
    userPreferences UserPreferences?

    @@unique([email])
    @@map("Users")
}

enum ApplicationTheme {
    SYSTEM
    LIGHT
    DARK
}

model UserPreferences {
    id String @id @default(uuid())

    monthlySpendingLimit Float
    defaultCurrency      String
    preferredLanguage    String
    preferredTheme       ApplicationTheme @default(SYSTEM)

    createdAt DateTime @default(now())

    // Link to user - one-to-one
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@unique([userId])
    @@map("User Preferences")
}

enum TransactionType {
    INCOME
    EXPENSE
    TRANSFER
}

model Transaction {
    id          String          @id() @default(uuid())
    amount      Float
    type        TransactionType
    description String?
    category    String
    date        DateTime        @default(now())

    // SOURCE ACCOUNT (money comes from)
    sourceAccount   Account @relation("SourceAccountTransactions", fields: [sourceAccountId], references: [id], onDelete: Cascade)
    sourceAccountId String

    // TARGET ACCOUNT (money goes to) — optional
    targetAccount   Account? @relation("TargetAccountTransactions", fields: [targetAccountId], references: [id], onDelete: Cascade)
    targetAccountId String?

    @@index([sourceAccountId])
    @@index([targetAccountId])
    @@map("Transactions")
}

enum CategoryType {
    INCOME
    EXPENSE
}

model Categories {
    id          String   @id @default(uuid())
    incomes     String[]
    expenses    String[]
    createdAt   DateTime @default(now())
    lastUpdated DateTime @updatedAt()

    // Link to user - one-to-many
    user   User   @relation(fields: [userId], references: [id])
    userId String @unique

    @@map("User Transaction Categories")
}

enum GoalStatus {
    ACTIVE
    PAUSED
    FAILED
    PENDING
    COMPLETED
}

enum GoalCategory {
    LOAN
    TRAVEL
    SAVINGS
    PURCHASE
    VACATION
    EDUCATION
    RETIREMENT
    INVESTMENTS
    DEBT_PAYMENT
    EMERGENCY_FUND
    OTHER
}

model Goals {
    id     String @id @default(uuid())
    userId String

    name        String
    currency    String
    description String

    endDate   DateTime
    startDate DateTime

    status   GoalStatus   @default(ACTIVE)
    category GoalCategory

    monthlyContribution Float
    targetAmount        Float
    currentAmount       Float @default(0)

    updatedAt DateTime @updatedAt()
    createdAt DateTime @default(now())

    @@map("Financial Goals")
}

enum BillType {
    YEARLY
    MONTHLY
    ONE_TIME
}

model Bills {
    id     String @id @default(uuid())
    userId String

    amount   Float
    name     String
    type     BillType
    currency String

    dueDate DateTime

    createdAt DateTime @default(now())

    @@map("User Bills")
}

enum SplitCategoryTag {
    FOOD
    DESERT
    DRINKS
    SHOPPING
    UTILITIES
    TRANSPORT
    ENTERTAINMENT
}

enum SplitStrategy {
    SOLE
    EQUAL
    QUANTITY
}

enum PaymentStrategy {
    ONE
    EQUAL
    CUSTOM
}

model SplitwiseSquad {
    id            String    @id @default(uuid())
    creatorId     String

    squadName     String
    squadImageKey String?
    squadMembers  String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@map("Splitwise Squads")
}

model QuantitySplit {
    id String @id @default(uuid())

    consumerQuantity Int
    consumerName String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // Link to splittable - one-to-many
    splittableId String
    splittable Splittable @relation(fields: [splittableId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Quantity Splits")
}

model BillPayer {
    id String @id @default(uuid())

    payerName   String
    payerAmount Float

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // Link to splitwise event - one-to-many
    splitwiseEventId String
    splitwiseEvent SplitwiseEvent @relation(fields: [splitwiseEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Bill Payers")
}

model Splittable{
    id            String        @id @default(uuid())

    name          String
    quantity      Int
    unitPrice     Float
    
    total         Float
    settled       Boolean       @default(false)
    splitStrategy SplitStrategy

    updatedAt     DateTime      @updatedAt()
    createdAt     DateTime      @default(now())

    // Link to quantity splits - one-to-many
    quantitySplits QuantitySplit[]

    splitEventId String
    splitEvent   SplitwiseEvent @relation(fields: [splitEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("Splittables")
}

model SplitwiseEvent {
    id            String    @id @default(uuid())
    creatorId     String

    eventName           String
    eventDate           DateTime

    squadName           String
    eventMembers        String[]

    verificationTotal   Float
    billingCurrency     String
    billPaymentStrategy PaymentStrategy
    billPayers          BillPayer[]

    eventSplittables    Splittable[]

    settledAt     DateTime?
    updatedAt     DateTime      @updatedAt()
    createdAt     DateTime      @default(now())

    @@map("Splitwise Events")
}
