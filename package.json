{
  "name": "pocket-pilot",
  "version": "1.0.0",
  "description": "Navigate your personal finances.",
  "keywords": [
    "NestJs",
    "Angular",
    "Monorepo",
    "Full-Stack"
  ],
  "workspaces": [
    "./server",
    "./frontend/web",
    "./frontend/mobile"
  ],
  "repository": {
    "type": "git",
    "url": "git@personal:danielgithiomi/pocket-pilot.git"
  },
  "license": "ISC",
  "author": "danielgithiomi <https://github.com/danielgithiomi>",
  "homepage": "https://github.com/danielgithiomi/pocket-pilot#readme",
  "type": "commonjs",
  "main": "index.js",
  "dependencies": {
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "turbo": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "prisma:studio": "turbo run prisma:studio",
    "dev": "turbo run dev --parallel --no-cache",
    "check-types": "echo \"Skipping type checking for server\"",
    "docker:up": "turbo run docker:up --filter=pocket-pilot-server",
    "prisma:reset": "turbo run prisma:reset --filter=pocket-pilot-server",
    "prisma:generate": "turbo run prisma:generate --filter=pocket-pilot-server",
    "prisma:migrate": "turbo run prisma:migrate --filter=pocket-pilot-server --",
    "clean": "turbo run clean && rimraf node_modules package-lock.json .turbo .cache && npm cache clean --force"
  },
  "lint-staged": {
    "packages/styles/index.css": [
      "git add"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.12.1",
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@syncfusion/ej2-angular-base@33.2.10": true,
    "argon2@0.44.0": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.6.0": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
