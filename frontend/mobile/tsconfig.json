{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"],
            "@shared/*": ["./../shared/*"],
            "@types/*": ["./../shared/types/*"],
            "@types": ["./../shared/types/index.ts"],
            "@atoms/*": ["./src/components/ui/atoms/*"],
            "@atoms": ["./src/components/ui/atoms/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
