{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"],
            "@atoms/*": ["./src/components/ui/atoms/*"],
            "@atoms": ["./src/components/ui/atoms/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
