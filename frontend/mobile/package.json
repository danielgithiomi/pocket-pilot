{
  "name": "pocket-pilot-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "author": "danielgithiomi <https://github.com/danielgithiomi>",
  "description": "This is the pocket-pilot mobile application developed with Expo - React Native.",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.2",
    "lightningcss": "^1.30.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "expo lint",
    "dev": "expo start --port 8088",
    "start": "expo start --port 8088",
    "preweb": "npm run sync:assets && npm run generate:colors",
    "preios": "npm run sync:assets && npm run generate:colors",
    "predev": "npm run sync:assets && npm run generate:colors",
    "prelint": "npm run generate:colors",
    "prestart": "npm run sync:assets && npm run generate:colors",
    "ios": "expo start --ios --port 8088",
    "web": "expo start --web --port 8088",
    "preandroid": "npm run sync:assets && npm run generate:colors",
    "android": "expo start --android --port 8088",
    "reset-project": "node ./scripts/reset-project.js",
    "generate:colors": "node ../shared/scripts/generate-colors.cjs",
    "sync:assets": "node ../shared/scripts/sync-assets.cjs mobile",
    "clean": "rimraf node_modules package-lock.json .turbo .expo .claude .cache && npm cache clean --force"
  },
  "packageManager": "npm@11.12.1"
}
