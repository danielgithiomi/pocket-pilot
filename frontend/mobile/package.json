        "expo-device": "~57.0.1",
        "expo-font": "~57.0.1",
        "expo-glass-effect": "~57.0.1",
        "expo-image": "~57.0.3",
        "expo-linking": "~57.0.6",
        "expo-router": "~57.0.14",
        "expo-splash-screen": "~57.0.7",
        "expo-status-bar": "~57.0.1",
        "expo-symbols": "~57.0.1",
        "expo-system-ui": "~57.0.2",
        "expo-web-browser": "~57.0.2",
        "nativewind": "^5.0.0-preview.4",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.2",
        "react-native-css": "^3.0.7",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "~19.2.2",
        "eslint-config-expo": "~57.0.1",
        "lightningcss": "^1.30.1",
        "postcss": "^8.5.26",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "generate:colors": "node ../shared/scripts/generate-colors.cjs",
        "prelint": "npm run generate:colors",
        "lint": "expo lint",
        "predev": "npm run generate:colors",
        "dev": "expo start --port 8088",
        "prestart": "npm run generate:colors",
        "start": "expo start --port 8088",
        "preios": "npm run generate:colors",
        "ios": "expo start --ios --port 8088",
        "preweb": "npm run generate:colors",
        "web": "expo start --web --port 8088",
        "preandroid": "npm run generate:colors",
        "android": "expo start --android --port 8088",
        "reset-project": "node ./scripts/reset-project.js",
        "clean": "rimraf node_modules package-lock.json .turbo .expo .claude .cache && npm cache clean --force"
    }
