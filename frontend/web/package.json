{
    "name": "pocket-pilot-web",
    "version": "1.0.0",
    "author": "danielgithiomi <https://github.com/danielgithiomi>",
    "description": "This is the pocket-pilot web application developed with Angular.",
    "private": true,
    "license": "ISC",
    "type": "module",
    "scripts": {
        "ng": "ng",
        "generate:colors": "node ../shared/scripts/generate-colors.cjs",
        "predev": "npm run generate:colors && ts-node scripts/set-env.development.ts",
        "dev": "ng serve",
        "test": "ng test",
        "prestart": "npm run generate:colors",
        "start": "ng serve",
        "build": "ng build",
        "pre-dev": "ts-node scripts/set-env.development.ts",
        "prebuild": "npm run generate:colors && ts-node scripts/set-env.production.ts",
        "watch": "ng build --watch --configuration development",
        "clean": "rimraf node_modules package-lock.json .turbo .angular .cache && npm cache clean --force"
    },
    "dependencies": {
        "@angular/animations": "^21.1.5",
        "@angular/common": "^21.1.0",
        "@angular/compiler": "^21.1.0",
        "@angular/core": "^21.1.0",
        "@angular/forms": "^21.1.0",
        "@angular/platform-browser": "^21.1.0",
        "@angular/router": "^21.1.0",
        "@syncfusion/ej2-angular-calendars": "^33.1.44",
        "lottie-web": "^5.13.0",
        "lucide": "^0.577.0",
        "lucide-angular": "^0.577.0",
        "ngx-lottie": "^21.2.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "vanilla-tilt": "^1.8.1"
    },
    "devDependencies": {
        "@angular/build": "^21.1.2",
        "@angular/cli": "^21.1.2",
        "@angular/compiler-cli": "^21.1.0",
        "@tailwindcss/postcss": "^4.1.12",
        "dotenv": "^17.4.1",
        "jsdom": "^27.1.0",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    },
    "packageManager": "npm@11.12.1"
}
